<?xml version="1.0" encoding="utf-8"?>
<!--
  Only needed if this built app (frontend/dist) is ever hosted as its own
  static IIS site/application instead of being copied into the API's wwwroot
  (see backend/KrishavERP.Api/Program.cs, which serves it with the same
  fallback behavior when merged). Requires the IIS "URL Rewrite" module.

  Vue Router uses browser history mode, so a hard reload or deep link (e.g.
  /patients) has no matching physical file on disk; without this rule IIS
  returns its own 404 for that request instead of index.html, and the app
  never gets a chance to boot - this is the "blank screen on reload" bug.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>
</configuration>
